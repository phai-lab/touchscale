# Copy to qc/.env and fill in. qc/.env is git-ignored; never commit real keys.

# Gemini API key (https://aistudio.google.com/apikey). GEMINI_API_KEY also works.
QC_API_KEY=

# Optional overrides.
# Any endpoint that speaks the Gemini generateContent protocol:
# QC_API_BASE=https://generativelanguage.googleapis.com
# Must accept video input:
# QC_MODEL=gemini-3.7-flash
# Model responses and clips (relative paths are relative to the working directory):
# QC_CACHE_DIR=/path/to/cache
